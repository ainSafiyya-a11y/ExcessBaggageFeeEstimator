<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_welcome"
        android:contentDescription="Background Image" />

    <!-- 2. Dark Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#77000000" />

    <!-- 3. Scrollable Content with Top Padding Fixed to 120dp -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="120dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:gravity="center_horizontal">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Excess Baggage Fee Estimator"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:layout_marginBottom="4dp"/>

            <!-- Version -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.0.0"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:layout_marginBottom="24dp"/>

            <!-- Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/cardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Developer Information"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/primaryDarkColor"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Name: NURAIN SAFIYYA BINTI SHARIN"
                        android:textColor="@color/textColorPrimary"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Student ID: 2024447638"
                        android:textColor="@color/textColorPrimary"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Group: RCDCS2515A"
                        android:textColor="@color/textColorPrimary"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Programme: CS251 (ICT602)"
                        android:textColor="@color/textColorPrimary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- GitHub Button -->
            <Button
                android:id="@+id/tvGithubLink"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="PROJECT REPOSITORY (GITHUB)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:backgroundTint="@color/primaryColor"
                app:cornerRadius="12dp"
                android:layout_marginTop="24dp" />

            <!-- Copyright -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="© 2026 Excess Baggage Fee Estimator. All Rights Reserved."
                android:textSize="12sp"
                android:textColor="#CCCCCC"
                android:textAlignment="center"
                android:layout_marginTop="32dp"/>

        </LinearLayout>
    </ScrollView>

</FrameLayout>